ANTHROPIC_API_KEY=
DATABASE_URL=

# Optional: gates the whole app behind a login screen with a persistent
# "remember me" session cookie. Required once deployed publicly (see
# README) -- without these set, anyone with the URL could burn your
# Anthropic credits. Leave unset for local dev if you want.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Optional: secret used to sign the session cookie issued at /login. If
# unset, falls back to BASIC_AUTH_PASSWORD (works fine, but a dedicated
# random secret is better practice since it's never sent to the browser).
AUTH_SECRET=
